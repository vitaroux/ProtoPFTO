# Collect 2030 - .gitignore

# Fichiers système
.DS_Store
Thumbs.db
desktop.ini

# Éditeurs
.vscode/
.idea/
*.sublime-*

# Logs
*.log
npm-debug.log*

# Dossiers temporaires
temp/
tmp/

# Fichiers de sauvegarde
*.bak
*.backup
*~

# Node modules (si vous ajoutez npm plus tard)
node_modules/

# Variables d'environnement
.env
.env.local
